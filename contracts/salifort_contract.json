{
  "dataset_name": "salifort_hr_attrition",
  "version": "1.0",
  "schema": {
    "expected_columns": [
      "satisfaction_level",
      "last_evaluation",
      "number_project",
      "average_monthly_hours",
      "time_spend_company",
      "work_accident",
      "left",
      "promotion_last_5years",
      "department",
      "salary"
    ],
    "strict_column_order": false,
    "allow_extra_columns": false
  },
  "columns": {
    "satisfaction_level": {
      "dtype": "float",
      "nullable": false,
      "min": 0.0,
      "max": 1.0
    },
    "last_evaluation": {
      "dtype": "float",
      "nullable": false,
      "min": 0.0,
      "max": 1.0
    },
    "number_project": {
      "dtype": "int",
      "nullable": false,
      "min": 1,
      "max": 15
    },
    "average_monthly_hours": {
      "dtype": "int",
      "nullable": false,
      "min": 40,
      "max": 400
    },
    "time_spend_company": {
      "dtype": "int",
      "nullable": false,
      "min": 0,
      "max": 50
    },
    "work_accident": {
      "dtype": "int",
      "nullable": false,
      "allowed_values": [0, 1]
    },
    "left": {
      "dtype": "int",
      "nullable": false,
      "allowed_values": [0, 1]
    },
    "promotion_last_5years": {
      "dtype": "int",
      "nullable": false,
      "allowed_values": [0, 1]
    },
    "department": {
      "dtype": "string",
      "nullable": false,
      "check_whitespace": true,
      "allowed_values": [
        "sales",
        "accounting",
        "hr",
        "technical",
        "support",
        "management",
        "IT",
        "product_mng",
        "marketing",
        "randd"
      ]
    },
    "salary": {
      "dtype": "string",
      "nullable": false,
      "check_whitespace": true,
      "allowed_values": ["low", "medium", "high"]
    }
  },
  "duplicates": {
    "policy": "warn_and_quarantine_excess",
    "keep": "first",
    "note": "Dataset lacks an employee_id primary key; verify exact duplicates with HR before permanent deletion."
  }
}
